# ─── MEXC Spread Monitor — Docker environment ─────────────────────────────────
# Copy this file to `.env` (next to docker-compose.yml) and fill in the values:
#     cp .env.docker.example .env
# `.env` is gitignored — never commit real secrets.

# REQUIRED. Auth token for admin/trading endpoints. Generate a strong one:
#     openssl rand -base64 32
ADMIN_TOKEN=

# Host port to expose the UI + API on (container always listens on 8006).
# Use 127.0.0.1:8006 semantics by putting a reverse proxy in front; here it's
# just the published host port.
APP_PORT=8006

# ─── Optional: egress proxy for geo-blocked exchange REST ─────────────────────
# Only needed if the host's region can't reach Binance/MEXC/Bybit REST directly.
# Accepts http(s):// or socks5h:// . For a VLESS link, run the Xray bridge
# (scripts/xray_bridge.py, see docs/PROXY_XRAY.md) and point this at its SOCKS5:
#     MEXC_HTTP_PROXY=socks5h://host.docker.internal:10808
MEXC_HTTP_PROXY=

# Per-exchange overrides win over the shared proxy above. Value is a proxy URL
# or the literal "direct" to force a direct connection for that venue.
#     MEXC_HTTP_PROXY_BINANCE=socks5h://host.docker.internal:10808
#     MEXC_HTTP_PROXY_OKX=direct
# MEXC_HTTP_PROXY_BINANCE=
# MEXC_HTTP_PROXY_BYBIT=
# MEXC_HTTP_PROXY_MEXC=

# ─── Screener data sources (enable per your needs) ───────────────────────────
# Spot snapshot (2127 symbols) + bookTicker WS — the screener's core. Leave on.
MEXC_SPOT_ORDERBOOK_WS_ENABLED=true

# REST trades poller → trade_buffer (buy/sell imbalance, trades/min, VWAP).
# Works without proxy on EU hosts (Riga etc.). Polls /api/v3/trades per symbol.
MEXC_REST_TRADES_POLLER_ENABLED=true
MEXC_REST_TRADES_POLLER_INTERVAL_SEC=5.0
MEXC_REST_TRADES_POLLER_LIMIT=500
MEXC_REST_TRADES_POLLER_MAX_SYMBOLS=30

# SQLite history (spread history charts + screener opportunity events). Persisted
# on the app-data volume, survives container restarts.
MEXC_HISTORY_ENABLED=true
